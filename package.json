{
  "name": "cartodex",
  "version": "0.1.1",
  "description": "Initialize Cartodex repository-local Codex assets.",
  "license": "MIT",
  "author": "Igor TT",
  "type": "module",
  "homepage": "https://github.com/igorTT/cartographer-codex#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igorTT/cartographer-codex.git"
  },
  "bugs": {
    "url": "https://github.com/igorTT/cartographer-codex/issues"
  },
  "keywords": [
    "codex",
    "cartodex",
    "codebase-map",
    "repository-analysis",
    "ai-agent",
    "documentation"
  ],
  "bin": {
    "cartodex": "dist/cli.js"
  },
  "files": [
    "dist",
    "src/templates",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "npm run build:scanner && tsc -p tsconfig.json",
    "build:scanner": "esbuild src/scanner/scan-codebase.ts --bundle --platform=node --target=node20 --format=esm --minify --outfile=src/templates/skill/scripts/scan-codebase.mjs --banner:js='#!/usr/bin/env node'",
    "test": "vitest run",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "commander": "14.0.3",
    "js-tiktoken": "1.0.21",
    "minimatch": "10.2.5"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "esbuild": "0.27.7",
    "typescript": "5.9.3",
    "vitest": "3.2.6"
  },
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=20"
  }
}
