{
  "name": "cartodex-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=cartodex",
    "build:scanner": "npm run build:scanner --workspace=cartodex",
    "test": "npm run build:scanner && npm test --workspace=cartodex",
    "pack:cartodex": "npm pack --workspace=cartodex --dry-run"
  },
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=20"
  }
}
