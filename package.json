{
  "name": "cartodex-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pack:cartodex": "npm pack --workspace=cartodex --dry-run",
    "pack:runtime": "npm pack --workspace=@cartodex/runtime --dry-run"
  },
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=20"
  }
}
